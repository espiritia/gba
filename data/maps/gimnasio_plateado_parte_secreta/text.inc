PewterCave_Text_BrockGreeting::
    .string "¡Me alegro de volver a verte!\n"
    .string "Espero que te encuentres bien.\p"
    .string "Sabía que algo estaba ocurriendo\n"
    .string "y envié a ONIX a vigilar.\p"
    .string "Por suerte, pudo rescatarte a\n"
    .string "tiempo, pero este lugar no va a\l"
    .string "aguantar demasiado tiempo.$"

PewterCave_Text_BrockGivesGeodude::
    .string "Vas a necesitar a este GEODUDE\n"
    .string "para salir de aquí antes de que\l"
    .string "el techo colapse.\p"
    .string "¡Ya sabe usar FUERZA!$"

PewterCave_Text_BrockRemindStrength::
    .string "Recuerda que tu GEODUDE sabe\n"
    .string "usar FUERZA. ¡Sal de aquí antes\l"
    .string "de que el techo colapse!$"

PewterCave_Text_ReceivedGeodude::
    .string "¡{PLAYER} recibió un GEODUDE\n"
    .string "de BROCK!$"

PewterCave_Text_GeodudeSentToPC::
    .string "No había sitio en tu equipo:\n"
    .string "GEODUDE se ha enviado al PC.$"

PewterCave_Text_BrockWillWait::
    .string "Te estaré esperando más adelante.\p"
    .string "Tengo que darme prisa para\n"
    .string "asegurar que la salida no\l"
    .string "quede bloqueada.$"

PewterCave_Text_RoofCollapses::
    .string "¡El techo de la cueva se\n"
    .string "derrumba!$"

PewterCave_Text_MoreDebris::
    .string "¡Cada vez caen más escombros!$"

PewterCave_Text_RoofGivingWay::
    .string "¡El techo está empezando a ceder!\n"
    .string "¡Hay que darse prisa!$"

PewterCave_Text_TrainingSign::
    .string "Zona de entrenamiento privada\n"
    .string "del Gimnasio Roca.$"
